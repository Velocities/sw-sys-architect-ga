{
    "name": "default",
    "description": "Default simulator configuration",
    "seed": 42,
    "duration_seconds": 30,
    "requests_per_second": 20,
    "failure_injection": {
        "enabled": true,
        "preset": "kill_primary_db",
        "events": [
            {
                "type": "node_down",
                "target": "db-primary",
                "at_time_ms": 10000,
                "duration_ms": 5000
            }
        ]
    },
    "metrics": {
        "collect_latency_percentiles": true,
        "collect_throughput": true,
        "collect_cost": true
    }
}
