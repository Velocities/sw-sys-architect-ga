{
    "name": "example-api-gateway",
    "version": "1.0",
    "description": "Example distributed architecture for development and testing",
    "nodes": [
        {
            "id": "lb-1",
            "type": "LoadBalancer"
        },
        {
            "id": "api-1",
            "type": "Api",
            "max_concurrent_requests": 128,
            "monthly_cost": 200.0
        },
        {
            "id": "redis-1",
            "type": "Redis"
        },
        {
            "id": "db-primary",
            "type": "Postgres"
        }
    ],
    "edges": [
        {
            "from": "lb-1",
            "to": "api-1",
            "latency_ms": 1.0,
            "bandwidth_mbps": 1000
        },
        {
            "from": "api-1",
            "to": "redis-1",
            "latency_ms": 0.5,
            "bandwidth_mbps": 1000
        },
        {
            "from": "redis-1",
            "to": "db-primary",
            "latency_ms": 2.5,
            "bandwidth_mbps": 500
        }
    ]
}
