{
    "name": "EvoArch",

    "build": {
        "dockerfile": "Dockerfile"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools",
                "twxs.cmake",
                "ms-azuretools.vscode-docker"
            ]
        }
    },

    "remoteUser": "vscode",

    "postCreateCommand": "cmake --version && ninja --version && vcpkg version"
}